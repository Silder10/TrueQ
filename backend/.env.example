# Copia este archivo como .env y completa con tus valores reales.
# .env NUNCA debe subirse al repositorio (ver .gitignore).

FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-generada-con-secrets.token_hex-32

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=trueq_db

# Origen(es) del frontend permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
