# Copia este archivo como .env y completa tus valores reales.
# .env NUNCA debe subirse al repositorio.

FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-generada-con-secrets.token_hex-32

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=trueq_db

# Servidor Flask
HOST=0.0.0.0
PORT=5001

# En desarrollo con Vite no necesitas cambiar CORS si accedes
# al frontend mediante el proxy.
CORS_ORIGINS=http://localhost:5173

# Si frontend y backend están en dominios distintos en producción:
# FRONTEND_URL=https://tu-frontend.example
